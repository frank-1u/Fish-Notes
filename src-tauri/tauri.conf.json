{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fish Notes",
  "version": "1.0.2",
  "identifier": "com.fishnotes.desktop",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fish Notes",
        "create": false,
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' fish-image: http://fish-image.localhost https://fish-image.localhost data: blob: https: http:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "../src/assets/icon.iconset/icon_16x16@2x.png",
      "../src/assets/icon.iconset/icon_128x128@2x.png",
      "icons/icon.ico",
      "../src/assets/icon.icns"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5QTcxRDdEOUZCRDU4QTQKUldTa1dMMmZmUjJudWZZbHV6NG93UVRPb0FOYy8vQ1Nnc3IyWDk2eU8rNWpDS05JTmM2MlF3dkgK",
      "endpoints": ["https://github.com/frank-1u/Fish-Notes/releases/latest/download/latest.json"]
    }
  }
}
