{
  "name": "fish-notes",
  "productName": "Fish Notes",
  "version": "1.2.0",
  "description": "A Markdown note-taking app built with React + Tauri",
  "private": true,
  "scripts": {
    "start": "tauri dev",
    "package": "tauri build --no-bundle",
    "make": "tauri build",
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "lint": "eslint --ext .ts,.tsx .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:frontend": "eslint --ext .ts,.tsx --quiet . && yarn format:check && tsc --noEmit && yarn test && vite build"
  },
  "keywords": [],
  "author": {
    "name": "Quentin",
    "email": "tangqianyu123@outlook.com"
  },
  "license": "MIT",
